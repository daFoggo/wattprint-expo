# Inlined into the app bundle. Never put secrets here.
EXPO_PUBLIC_APP_ENV=development
# FastAPI base URL including the version prefix. Default: http://localhost:8000/api/v1 (emulator, or a phone
# with `adb reverse tcp:8000 tcp:8000`). On a physical phone without adb reverse use the LAN IP of the
# machine running FastAPI, e.g. http://192.168.1.20:8000/api/v1. Auth (register, token, refresh, logout) uses it too.
EXPO_PUBLIC_API_URL=
