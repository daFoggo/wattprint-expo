# Inlined into the app bundle. Never put secrets here.
EXPO_PUBLIC_APP_ENV=development
# FastAPI base URL including the version prefix, e.g. http://localhost:8000/api/v1
EXPO_PUBLIC_API_URL=
# Better Auth service, e.g. http://localhost:3000 (the phone reaches it with adb reverse)
EXPO_PUBLIC_AUTH_URL=
