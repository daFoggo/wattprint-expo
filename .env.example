# Inlined into the app bundle. Never put secrets here.
EXPO_PUBLIC_APP_ENV=development
# FastAPI base URL including the version prefix. Default: http://localhost:11093/api/v1 (emulator, or a phone
# with `adb reverse tcp:11093 tcp:11093`). On a physical phone without adb reverse use the LAN IP of the
# machine running FastAPI, e.g. http://192.168.1.20:11093/api/v1.
EXPO_PUBLIC_API_URL=
# Keycloak realm URL (docker compose in wattprint-fastapi). Default: http://localhost:11095/realms/wattprint (needs
# `adb reverse tcp:11095 tcp:11095`). It must equal KEYCLOAK_ISSUER of the API, so on a LAN phone use the same LAN URL in both.
EXPO_PUBLIC_KEYCLOAK_URL=
