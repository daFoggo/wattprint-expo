# Inlined into the app bundle. Never put secrets here.
EXPO_PUBLIC_APP_ENV=development
# FastAPI base URL including the version prefix. Default: http://localhost:8000/api/v1 (emulator, or a phone
# with `adb reverse tcp:8000 tcp:8000`). On a physical phone without adb reverse use the LAN IP of the
# machine running FastAPI, e.g. http://192.168.1.20:8000/api/v1.
EXPO_PUBLIC_API_URL=
# Keycloak realm URL (docker compose in wattprint-fastapi). Default: http://localhost:8180/realms/wattprint (needs
# `adb reverse tcp:8180 tcp:8180`). It must equal KEYCLOAK_ISSUER of the API, so on a LAN phone use the same LAN URL in both.
EXPO_PUBLIC_KEYCLOAK_URL=
