# Inlined into the app bundle. Never put secrets here.
EXPO_PUBLIC_APP_ENV=development
# Both default to the public stack (https://api.wattprint.ptitai.org/api/v1, https://auth.wattprint.ptitai.org/realms/wattprint):
# the backend's Keycloak issues tokens for its public issuer, so a localhost realm URL cannot sign in. Set them only for a
# local stack that runs with its own issuer (then the same URL in the API's KEYCLOAK_ISSUER).
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_KEYCLOAK_URL=
